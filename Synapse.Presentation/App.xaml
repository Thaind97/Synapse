<Application x:Class="Synapse.Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Synapse.Presentation"
             xmlns:viewmodels="clr-namespace:Synapse.Presentation.ViewModels"
             xmlns:views="clr-namespace:Synapse.Presentation.Views">
    <Application.Resources>
        <!-- DataTemplates to Map ViewModels to Views -->
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:EVControlViewModel}">
            <views:EVControlView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SequenceEditorViewModel}">
            <views:SequenceEditorView/>
        </DataTemplate>
    </Application.Resources>
</Application>
