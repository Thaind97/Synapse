<UserControl x:Class="Synapse.Presentation.Views.SequenceEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Synapse.Presentation.Views"
             xmlns:vm="clr-namespace:Synapse.Presentation.ViewModels"
             xmlns:converters="clr-namespace:Synapse.Presentation.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="#FAFAFA">
    <UserControl.Resources>
        <converters:CommandColorConverter x:Key="CommandColorConverter"/>
        
        <Style TargetType="Button" x:Key="ActionButtonStyle">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                         <Border Background="{TemplateBinding Background}" 
                                 BorderBrush="{TemplateBinding BorderBrush}" 
                                 BorderThickness="1"
                                 CornerRadius="5" Padding="5">
                             <ContentPresenter/>
                         </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="#4CAF50"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="Background" Value="#F1F8E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Column 1: Sequences -->
        <Grid Grid.Column="0" Margin="0,0,5,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBox Grid.Row="0" Margin="0,0,0,5" Padding="5" Text="Search..." Foreground="Gray"/>
            
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Add" Command="{Binding AddSequenceCommand}" Style="{StaticResource ActionButtonStyle}" Width="60"/>
                <Button Content="Delete" Command="{Binding DeleteSequenceCommand}" Style="{StaticResource ActionButtonStyle}" Width="60"/>
            </StackPanel>
            
            <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,5,0,0" Background="White">
                <ListBox ItemsSource="{Binding Sequences}" SelectedItem="{Binding SelectedSequence}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="" HorizontalAlignment="Right" Foreground="Gray"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            
            <TextBlock Grid.Row="3" Text="{Binding Sequences.Count, StringFormat='Total: {0} sequences'}" Margin="0,5,0,0" FontSize="11" Foreground="Gray"/>
        </Grid>

        <!-- Column 2: Partition/Steps -->
        <Grid Grid.Column="1" Margin="5,0">
             <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Add" Command="{Binding AddStepCommand}" Style="{StaticResource ActionButtonStyle}" Width="50"/>
                <Button Content="Delete" Command="{Binding DeleteStepCommand}" Style="{StaticResource ActionButtonStyle}" Width="50"/>
                <Button Content="↑" Command="{Binding MoveStepUpCommand}" Style="{StaticResource ActionButtonStyle}" Width="30"/>
                <Button Content="↓" Command="{Binding MoveStepDownCommand}" Style="{StaticResource ActionButtonStyle}" Width="30"/>
            </StackPanel>

            <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,5,0,0" Background="White">
                <ListBox ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="10" Padding="10" Margin="5" Background="White">
                                <TextBlock Text="{Binding StepName}" HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- Column 3: Commands -->
        <Grid Grid.Column="2" Margin="5,0">
             <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Add" Command="{Binding AddDeviceCommandCommand}" Style="{StaticResource ActionButtonStyle}" Width="50"/>
                <Button Content="Delete" Command="{Binding DeleteDeviceCommandCommand}" Style="{StaticResource ActionButtonStyle}" Width="50"/>
                <Button Content="↑" Command="{Binding MoveCommandUpCommand}" Style="{StaticResource ActionButtonStyle}" Width="30"/>
                <Button Content="↓" Command="{Binding MoveCommandDownCommand}" Style="{StaticResource ActionButtonStyle}" Width="30"/>
            </StackPanel>

            <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,5,0,0" Background="White">
                 <ListBox ItemsSource="{Binding Commands}" SelectedItem="{Binding SelectedCommand}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                             <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="0" Padding="10" Margin="5" Background="{Binding Device, Converter={StaticResource CommandColorConverter}}">
                                 <Grid>
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="Auto"/>
                                         <ColumnDefinition Width="*"/>
                                     </Grid.ColumnDefinitions>
                                     <!-- Imagine an icon here -->
                                     <TextBlock Grid.Column="1" Text="{Binding Command}" HorizontalAlignment="Center"/>
                                 </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            
            <!-- Quick Add Buttons -->
             <UniformGrid Grid.Row="2" Columns="2" Margin="0,5,0,0">
                 <Button Content="Device Cmd" Command="{Binding AddDeviceCommandCommand}" Background="#FFCDD2" Margin="2"/>
                 <Button Content="Wait" Command="{Binding AddWaitCommandCommand}" Background="#FFF9C4" Margin="2"/>
                 <Button Content="Loop" Command="{Binding AddLoopCommandCommand}" Background="#C8E6C9" Margin="2"/>
             </UniformGrid>
        </Grid>

        <!-- Column 4: Parameters -->
        <Grid Grid.Column="3" Margin="5,0,0,0">
             <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <StackPanel Grid.Row="0">
                <TextBlock Text="Step Name" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedStep.StepName}" Margin="0,0,0,5"/>
                
                <TextBlock Text="Device" FontWeight="Bold"/>
                <ComboBox ItemsSource="{Binding Devices}" Text="{Binding SelectedCommand.Device}" IsEditable="True" Margin="0,0,0,5"/>
                
                <TextBlock Text="Command" FontWeight="Bold"/>
                 <ComboBox ItemsSource="{Binding AvailableCommands}" Text="{Binding SelectedCommand.Command}" IsEditable="True" Margin="0,0,0,10"/>
                
                <TextBlock Text="Parameter Setting" FontSize="14" FontWeight="Bold" Margin="0,10,0,5"/>
            </StackPanel>

            <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" Background="White" Padding="10">
                 <ItemsControl ItemsSource="{Binding Parameters}">
                     <ItemsControl.ItemTemplate>
                         <DataTemplate>
                             <Grid Margin="0,5">
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                     <ColumnDefinition Width="*"/>
                                     <ColumnDefinition Width="Auto"/>
                                 </Grid.ColumnDefinitions>
                                 <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                 <!-- Simple text box for Value -->
                                 <TextBox Grid.Column="1" Text="{Binding Value}"/>
                                 <Button Grid.Column="2" Content="Select" Width="50" Margin="5,0,0,0" Style="{StaticResource ActionButtonStyle}"/>
                             </Grid>
                         </DataTemplate>
                     </ItemsControl.ItemTemplate>
                 </ItemsControl>
            </Border>
            
            <Button Grid.Row="2" Content="Save Sequence" Command="{Binding SaveChangesCommand}" Height="40" Margin="0,10,0,0" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
        </Grid>
    </Grid>
</UserControl>
