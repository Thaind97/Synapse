<UserControl x:Class="Synapse.Presentation.Views.EVControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="1400" Background="#0F1219">

    <UserControl.Resources>
        <!-- Card Style -->
        <Style x:Key="EVCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1C212D"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#4FD1C5"/>
                    <Setter Property="Background" Value="#252B3A"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#252B3B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Command Button Style -->
        <Style x:Key="CommandButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Bar -->
                <RowDefinition Height="Auto"/> <!-- Battery Grid -->
                <RowDefinition Height="*"/>    <!-- Overview & Stats -->
            </Grid.RowDefinitions>

            <!-- Top Bar Controls -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Border Background="#1C212D" CornerRadius="4" Padding="5">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource CommandButtonStyle}" Command="{Binding StartCommand}">
                                <StackPanel Orientation="Horizontal" Margin="5,0">
                                    <Border Background="#4A2B2B" CornerRadius="4" Width="20" Height="20" Margin="0,0,8,0">
                                         <Rectangle Width="8" Height="8" Fill="#C94C4C"/>
                                    </Border>
                                    <TextBlock Text="START" Foreground="White" VerticalAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{StaticResource CommandButtonStyle}" Command="{Binding StopCommand}">
                                <StackPanel Orientation="Horizontal" Margin="5,0">
                                    <Ellipse Width="10" Height="10" Fill="#C94C4C" Margin="0,0,8,0"/>
                                    <TextBlock Text="STOP" Foreground="White" VerticalAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource CommandButtonStyle}">
                                <StackPanel Orientation="Horizontal" Margin="5,0">
                                    <Ellipse Width="10" Height="10" Fill="#3D866E" Margin="0,0,8,0"/>
                                    <TextBlock Text="EMERGENCY STOP" Foreground="White" VerticalAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    
                    <TextBlock Text="{Binding StatusDescription}" Foreground="#4FD1C5" FontWeight="Bold" Margin="30,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="#1C212D" Padding="10" CornerRadius="6" Margin="0,0,10,0">
                         <Path Data="M20,6h-8l-2-2H4C2.9,4,2,4.9,2,6v12c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V8C22,6.9,21.1,6,20,6z" Fill="#9CA3AF" Width="20" Height="20"/>
                    </Border>
                    <Border Background="#1C212D" Padding="10" CornerRadius="6">
                         <Path Data="M4,11h5V5H4V11z M4,19h5v-6H4V19z M11,19h5v-6h-5V19z M11,11h5V5h-5V11z M17,11h5V5h-5V11z M17,19h5v-6h-5V19z" Fill="#9CA3AF" Width="20" Height="20"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Battery Grid -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="550" Margin="0,0,0,10">
                <ItemsControl ItemsSource="{Binding Batteries}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource EVCardStyle}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" 
                                                  Command="{Binding DataContext.SelectBatteryCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}" 
                                                  CommandParameter="{Binding .}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,5">
                                        <TextBlock Text="{Binding Voltage, StringFormat={}{0:F2} V}" Foreground="#9CA3AF" FontSize="11" Margin="0,0,10,0"/>
                                        <Path Data="M7,14L12,9L17,14H7Z" Fill="#3D866E" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding PassCount}" Foreground="#3D866E" FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>
                                    <lvc:CartesianChart Grid.Row="2" Height="30" DisableAnimations="True" Hoverable="False" DataTooltip="{x:Null}">
                                        <lvc:CartesianChart.Series>
                                            <lvc:LineSeries Values="{Binding HistoryData}" 
                                                            StrokeThickness="1.2"
                                                            Stroke="#3D866E"
                                                            Fill="Transparent"
                                                            PointGeometry="{x:Null}"/>
                                        </lvc:CartesianChart.Series>
                                        <lvc:CartesianChart.AxisX><lvc:Axis ShowLabels="False" /></lvc:CartesianChart.AxisX>
                                        <lvc:CartesianChart.AxisY><lvc:Axis ShowLabels="False" /></lvc:CartesianChart.AxisY>
                                    </lvc:CartesianChart>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Bottom Content -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource EVCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Detailed Analysis - " Foreground="White" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding SelectedBatteryName}" Foreground="#4FD1C5" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                            <lvc:CartesianChart Grid.Row="1" Series="{Binding OverviewSeries}" LegendLocation="None">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Title="Time" Labels="{Binding OverviewLabels}" Foreground="#444">
                                        <lvc:Axis.Separator><lvc:Separator Stroke="#222" IsEnabled="True" /></lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Foreground="#444">
                                        <lvc:Axis.Separator><lvc:Separator Stroke="#222" IsEnabled="True" /></lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource EVCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Thread Allocation Table" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <DataGrid ItemsSource="{Binding Steps}" AutoGenerateColumns="False" 
                                      Background="Transparent" BorderThickness="0" RowBackground="Transparent" 
                                      VerticalGridLinesBrush="#222" HorizontalGridLinesBrush="#222"
                                      Foreground="#9CA3AF" HeadersVisibility="Column" IsReadOnly="True">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#666"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#222"/>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Operation" Binding="{Binding Step}" Width="150"/>
                                    <DataGridTextColumn Header="Service Handle / IPC Endpoint" Binding="{Binding Description}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource EVCardStyle}" Height="200">
                        <UniformGrid Columns="2">
                            <Grid Margin="10">
                                <Path Data="M50,10 A40,40 0 1,1 10,50" Stroke="#10B981" StrokeThickness="6" StrokeEndLineCap="Round" 
                                      Width="70" Height="70" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Selected Battery SOC"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="SOC" FontSize="8" Foreground="#9CA3AF" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedBattery.StateOfCharge, StringFormat={}{0}%}" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            
                            <Grid Margin="10">
                                <Ellipse Width="70" Height="70" Stroke="#252B3A" StrokeThickness="6"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedBattery.Voltage, StringFormat={}{0:F2}}" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Volts" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </UniformGrid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource EVCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Active IPC Nodes" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Step}" Foreground="#9CA3AF" FontSize="12"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
